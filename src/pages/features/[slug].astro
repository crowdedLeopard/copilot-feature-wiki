---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Facts from '../../components/Facts.astro';
import Badge from '../../components/Badge.astro';
import SectionHead from '../../components/SectionHead.astro';
import AtlasMini from '../../components/AtlasMini.astro';
import CheckReport from '../../components/CheckReport.astro';
import NoticeRow from '../../components/NoticeRow.astro';
import { allFeatures, allFeaturesIncludingArchived, allConcepts, lifecycle, reviewDue, conceptsExplaining, allNotices, nearestActBy } from '../../lib/data';
import { CHECK_LABEL } from '../../lib/check';
import { buildAtlas } from '../../lib/graph';
import '../../styles/briefing.css';
import { SITE, TOPIC_BY_ID, SOURCE_KIND, LIFECYCLE, VERIFICATION, href, topicUrl, tagUrl, featureUrl, conceptUrl, noticeUrl, formatDate, roadmapUrl, extractRationale, youtubeSearchUrl, learnSearchUrl } from '../../lib/site';
import { tagLabel } from '../../lib/tags';

export async function getStaticPaths() {
  // Archived briefings keep their address, so they are routed too.
  const features = await allFeaturesIncludingArchived();
  return features.map((f) => ({ params: { slug: f.data.slug }, props: { entry: f } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const features = await allFeatures();
const everything = await allFeaturesIncludingArchived();
const concepts = await allConcepts();
// Lifecycle: archived pages carry a notice; a live page whose roadmap item has been missing from the feed for more than a week says so; an old page says it is due a re-check.
const gone = !d.archived && d.roadmapId ? lifecycle.missing[String(d.roadmapId)] : undefined;
const goneDays = gone ? Math.floor((Date.now() - new Date(gone.missingSince).getTime()) / 86400000) : 0;
const due = reviewDue(entry);
const topic = (TOPIC_BY_ID as Record<string, { label: string }>)[d.topic];
const rationale = extractRationale(entry.body);
const related = d.related
  .map((slug) => {
    const f = everything.find((x) => x.data.slug === slug);
    if (f) return { title: f.data.title, url: featureUrl(slug), meta: f.data.archived ? `Archived briefing · ${(TOPIC_BY_ID as any)[f.data.topic]?.label ?? f.data.topic}` : `Briefing · ${(TOPIC_BY_ID as any)[f.data.topic]?.label ?? f.data.topic} · ${f.data.action === 'act-now' ? 'Act now' : f.data.risk + ' risk'}` };
    const c = concepts.find((x) => x.data.slug === slug);
    if (c) return { title: c.data.title, url: conceptUrl(slug), meta: 'Concept' };
    return null;
  })
  .filter(Boolean) as { title: string; url: string; meta: string }[];
const inbound = features.filter((f) => f.data.related.includes(d.slug) && f.data.slug !== d.slug && !d.related.includes(f.data.slug));
// Concept pages that explain a mechanism this briefing is tagged with, beyond those it names in `related`.
const explained = conceptsExplaining(entry, concepts).filter((c) => !d.related.includes(c.data.slug));
const toc = headings.filter((h) => h.depth === 2);
const atlas = buildAtlas(features, concepts);
const atlasNode = atlas.nodes.find((n) => n.id === `f:${d.slug}`);
const roadmap = roadmapUrl(d.roadmapId);
const editUrl = `${SITE.repo}/edit/main/wiki/features/${d.slug}.md`;
const pdfUrl = href(`/downloads/${d.slug}.pdf`);
const mdUrl = href(`/features/${d.slug}.md`);
const sources = d.sources.filter((s) => s.kind !== 'roadmap');
// Where this briefing's governance controls live: distinct admin centres and API kinds, with how many controls each covers.
const API_KIND_LABEL: Record<string, string> = { powershell: 'PowerShell', graph: 'Microsoft Graph', 'power-platform-api': 'Power Platform API', 'pac-cli': 'Power Platform CLI', 'azure-cli': 'Azure CLI', rest: 'REST API', other: 'API' };
const surfaces = new Map<string, number>();
for (const c of d.controls) {
  if (c.ui) surfaces.set(c.ui.surface, (surfaces.get(c.ui.surface) ?? 0) + 1);
  if (c.api) surfaces.set(API_KIND_LABEL[c.api.kind] ?? 'API', (surfaces.get(API_KIND_LABEL[c.api.kind] ?? 'API') ?? 0) + 1);
}
const gaps = { ui: d.controls.filter((c) => !c.ui).length, api: d.controls.filter((c) => !c.api).length };
const roadmapSource = d.sources.find((s) => s.kind === 'roadmap');
// Message Center posts Microsoft has sent tenants about this roadmap item, and the nearest deadline among them.
const notices = d.roadmapId ? (await allNotices()).filter((n) => n.data.roadmapIds.includes(d.roadmapId!)) : [];
const actBy = d.archived ? null : nearestActBy(notices);

// The independent check: the stamp in the front matter. The full report is rendered by CheckReport.
const v = d.verification ?? null;
const needsCorrection = v?.status === 'needs-correction';
---

<Base title={d.title} description={d.summary} kind="article" current="features">
  <article class="wrap">
    <header class="article-head">
      <div class="eyebrow">
        <a href={topicUrl(d.topic)}>{topic?.label ?? d.topic}</a>
        {d.roadmapId && <><span class="sep"></span><a href={roadmap!} rel="noopener">Roadmap {d.roadmapId}</a></>}
        <span class="sep"></span><Badge status={d.status} />
        {d.archived && <><span class="sep"></span><a href={href('/archive/')} class="archived-mark">Archived {formatDate(d.archived.date)}</a></>}
        <span class="sep"></span><span>Updated {formatDate(d.updated)}</span>
        {due && <><span class="sep"></span><span class="review-due" title={`Not written or refreshed for more than ${d.status === 'launched' ? LIFECYCLE.reviewAfterDays.launched : LIFECYCLE.reviewAfterDays.default} days. It is queued for a re-check; treat controls and licensing details as possibly out of date.`}>Review due</span></>}
        {d.confidence !== 'high' && <><span class="sep"></span><span title="How well the sources support this briefing">Confidence {d.confidence}</span></>}
        <span class="sep"></span>
        {v ? (
          <a href="#verification" class={`checked checked--${v.status}`} title={`Independent check against Microsoft Learn on ${formatDate(v.date, { long: true })}: ${CHECK_LABEL[v.status] ?? v.status}.`}>{needsCorrection ? 'Awaiting correction' : `Checked ${formatDate(v.date)}`}</a>
        ) : (
          <a href="#verification" class="checked checked--none" title="This page has not yet had its independent check against Microsoft Learn.">Not yet checked</a>
        )}
      </div>
      <h1 class="display">{d.title}</h1>
      <p class="standfirst">{d.summary}</p>
      {d.archived && (
        <div class="notice notice--archived" role="note">
          <strong>Archived on {formatDate(d.archived.date)}.</strong>{' '}
          {d.archived.reason === 'cancelled'
            ? 'Microsoft marked this roadmap item as cancelled.'
            : `This item left the Microsoft 365 Roadmap${d.archived.lastSeen ? ` (last seen ${formatDate(d.archived.lastSeen)})` : ''} and did not return within ${LIFECYCLE.removedGraceDays} days.`}{' '}
          The briefing is kept in full for reference. Its ratings and guidance describe the feature as it was announced and are not advice to act on now. <a href={href('/archive/')}>See the archive</a>.
        </div>
      )}
      {gone && goneDays > 7 && (
        <div class="notice notice--missing" role="note">
          <strong>Not seen on the Microsoft 365 Roadmap since {formatDate(gone.lastSeen ?? gone.missingSince)}.</strong>{' '}
          Microsoft may have withdrawn or renumbered the item. If it has not returned after {LIFECYCLE.removedGraceDays} days this briefing moves to the <a href={href('/archive/')}>archive</a>.
        </div>
      )}
      {needsCorrection && v && (
        <aside class="notice notice--correction" role="note">
          <p><b>Awaiting correction.</b> An independent check on {formatDate(v.date, { long: true })} could not confirm {v.unconfirmed} of the {v.claims} statements on this page against Microsoft documentation and found {v.contradicted} contradicted by it. They are listed under <a href="#verification">How this briefing was checked</a>. A corrected version is being prepared. Until then, confirm paths, commands and licensing against the linked Microsoft pages before acting on them.</p>
        </aside>
      )}
      <Facts data={d.archived ? { ...d, action: 'none' } : d} rationale={rationale} actBy={actBy ? { date: actBy.date, id: actBy.post.data.id } : null} />
    </header>

    <div class="article">
      <div class="article__body">
        <div class="prose">
          <Content />
        </div>

        {notices.length > 0 && (
          <>
            <SectionHead title="Message Centre notices" id="message-centre" />
            <p class="muted small" style="margin:-0.4rem 0 0.4rem;max-width:72ch">What Microsoft has told tenant administrators about this change, with any date by which something must be done. The briefing above was written with these posts in hand; open a post for Microsoft's full text.</p>
            <ul class="notices">{notices.map((n) => <NoticeRow entry={n} showTopic={false} />)}</ul>
          </>
        )}

        <CheckReport slug={d.slug} version={d.version} stamp={v} />

        <SectionHead title="Microsoft guidance and references" id="references" />
        <ul class="sources">
          {roadmapSource && (
            <li><span class="kind">Roadmap</span><span><a href={roadmapSource.url} rel="noopener">{roadmapSource.title}</a><span class="url">{roadmapSource.url}</span></span></li>
          )}
          {sources.map((s) => (
            <li><span class="kind">{(SOURCE_KIND as Record<string, string>)[s.kind] ?? s.kind}</span><span><a href={s.url} rel="noopener">{s.title}</a><span class="url">{s.url}</span></span></li>
          ))}
          <li><span class="kind">Search</span><span><a href={learnSearchUrl(d.title)} rel="noopener">Search Microsoft Learn for this feature</a></span></li>
        </ul>

        <SectionHead title="Videos" id="videos" />
        {d.videos.length ? (
          <ul class="sources">
            {d.videos.map((v) => (
              <li><span class="kind">{v.channel ?? 'Video'}</span><span><a href={v.url} rel="noopener">{v.title}</a><span class="url">{v.url}</span></span></li>
            ))}
          </ul>
        ) : (
          <p class="muted">No Microsoft video has been linked for this feature yet. <a href={youtubeSearchUrl(d.title)} rel="noopener">Search YouTube</a> for Microsoft Mechanics, Microsoft 365 Community and Power CAT sessions; the daily run adds a link when one is verified.</p>
        )}

        {(related.length > 0 || inbound.length > 0 || explained.length > 0) && (
          <>
            <SectionHead title="Related" id="related" />
            {atlasNode && <AtlasMini id={atlasNode.id} where={topic?.label ?? d.topic} links={atlasNode.n} />}
            <ul class="related">
              {related.map((r) => <li><a href={r.url}>{r.title}</a><span class="meta">{r.meta}</span></li>)}
              {explained.map((c) => <li><a href={conceptUrl(c.data.slug)}>{c.data.title}</a><span class="meta">Concept</span></li>)}
              {inbound.map((f) => <li><a href={featureUrl(f.data.slug)}>{f.data.title}</a><span class="meta">Links here · {(TOPIC_BY_ID as any)[f.data.topic]?.label ?? f.data.topic}</span></li>)}
            </ul>
          </>
        )}

        <SectionHead title="Tags" id="tags" />
        <div class="chips">
          {d.tags.map((t) => <a class="chip" href={tagUrl(t)}>{tagLabel(t)}</a>)}
        </div>

        <SectionHead title="Change log" id="changes" />
        <ul class="changes" style="list-style:none;margin:0;padding:0">
          {[...d.changes].reverse().map((c) => <li><time datetime={c.date}>{formatDate(c.date)}</time><span>{c.note}</span></li>)}
          {d.roadmapModified && <li><time datetime={d.roadmapModified}>{formatDate(d.roadmapModified)}</time><span class="muted">Roadmap entry last modified by Microsoft</span></li>}
        </ul>
        <p class="small muted" style="margin-top:1.2rem">
          Version {d.version} · created {formatDate(d.created)} · confidence {d.confidence}. This briefing was written from the sources above{v && v.status !== 'needs-correction' ? ` and checked independently against Microsoft Learn on ${formatDate(v.date)}` : ''}. It is rewritten when the roadmap entry changes, and checked again whenever its text changes, whenever a Microsoft page it cites changes, and in any case every {VERIFICATION.recheckDays} days (<a href={href('/accuracy/')}>Accuracy</a> shows every page's state). {d.archived ? 'It is archived and will not be refreshed unless the item returns to the roadmap.' : 'If Microsoft cancels or withdraws the item, the page moves to the archive rather than being deleted.'}
          {' '}Spotted an error? <a href={editUrl} rel="noopener">Propose a change on GitHub</a>.
        </p>
      </div>

      <aside class="article__aside no-print">
        <nav class="panel toc" aria-label="On this page">
          <h3>On this page</h3>
          <ol>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            {notices.length > 0 && <li><a href="#message-centre">Message Centre notices</a></li>}
            <li><a href="#verification">How this briefing was checked</a></li>
            <li><a href="#references">Microsoft guidance and references</a></li>
            <li><a href="#related">Related</a></li>
          </ol>
        </nav>
        <div class="panel">
          <h3>Download</h3>
          <div class="downloads">
            <a href={pdfUrl} download><span>Briefing as PDF</span><span class="ext">A4 · PDF</span></a>
            <a href={mdUrl} download={`${d.slug}.md`}><span>Briefing as Markdown</span><span class="ext">Obsidian · MD</span></a>
            {roadmap && <a href={roadmap} rel="noopener"><span>Microsoft 365 Roadmap entry</span><span class="ext">↗</span></a>}
            <button class="btn-ghost" type="button" onclick="window.print()" style="justify-content:space-between"><span>Print this page</span><span class="ext mono">⌘P</span></button>
          </div>
        </div>
        {notices.length > 0 && (
          <div class="panel">
            <h3>Message Centre</h3>
            <ul class="surfaces">
              {notices.map((n) => <li><a href={noticeUrl(n.data.id)} title={n.data.title}>{n.data.id}</a><span class="n">{n.data.actionRequiredBy ? `Act by ${formatDate(n.data.actionRequiredBy)}` : formatDate(n.data.lastModified)}</span></li>)}
            </ul>
            <p class="surfaces__foot">Microsoft's notices to tenant administrators about this item.</p>
          </div>
        )}
        {d.controls.length > 0 && (
          <div class="panel">
            <h3>Control surfaces</h3>
            <ul class="surfaces">
              {[...surfaces.entries()].sort((x, y) => y[1] - x[1] || x[0].localeCompare(y[0])).map(([name, n]) => <li><a href="#governance-controls">{name}</a><span class="n">{n} {n === 1 ? 'control' : 'controls'}</span></li>)}
              {gaps.ui > 0 && <li><span class="gap">No admin UI documented</span><span class="n">{gaps.ui} of {d.controls.length}</span></li>}
              {gaps.api > 0 && <li><span class="gap">No API documented</span><span class="n">{gaps.api} of {d.controls.length}</span></li>}
            </ul>
            <p class="surfaces__foot">Paths and cmdlets as Microsoft Learn documents them. Gaps are stated, not guessed.</p>
          </div>
        )}
        <div class="panel">
          <h3>Products</h3>
          <div class="chips">{d.products.map((p) => <span class="chip">{p}</span>)}</div>
        </div>
      </aside>
    </div>
  </article>
</Base>
