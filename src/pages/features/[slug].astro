---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Facts from '../../components/Facts.astro';
import Badge from '../../components/Badge.astro';
import SectionHead from '../../components/SectionHead.astro';
import AtlasMini from '../../components/AtlasMini.astro';
import { allFeatures, allConcepts, verificationFor } from '../../lib/data';
import { buildAtlas } from '../../lib/graph';
import '../../styles/briefing.css';
import { SITE, TOPIC_BY_ID, SOURCE_KIND, href, topicUrl, tagUrl, featureUrl, conceptUrl, formatDate, roadmapUrl, extractRationale, youtubeSearchUrl, learnSearchUrl } from '../../lib/site';
import { tagLabel } from '../../lib/tags';

export async function getStaticPaths() {
  const features = await allFeatures();
  return features.map((f) => ({ params: { slug: f.data.slug }, props: { entry: f } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const features = await allFeatures();
const concepts = await allConcepts();
const topic = (TOPIC_BY_ID as Record<string, { label: string }>)[d.topic];
const rationale = extractRationale(entry.body);
const related = d.related
  .map((slug) => {
    const f = features.find((x) => x.data.slug === slug);
    if (f) return { title: f.data.title, url: featureUrl(slug), meta: `Briefing · ${(TOPIC_BY_ID as any)[f.data.topic]?.label ?? f.data.topic} · ${f.data.action === 'act-now' ? 'Act now' : f.data.risk + ' risk'}` };
    const c = concepts.find((x) => x.data.slug === slug);
    if (c) return { title: c.data.title, url: conceptUrl(slug), meta: 'Concept' };
    return null;
  })
  .filter(Boolean) as { title: string; url: string; meta: string }[];
const inbound = features.filter((f) => f.data.related.includes(d.slug) && f.data.slug !== d.slug && !d.related.includes(f.data.slug));
const toc = headings.filter((h) => h.depth === 2);
const atlas = buildAtlas(features, concepts);
const atlasNode = atlas.nodes.find((n) => n.id === `f:${d.slug}`);
const roadmap = roadmapUrl(d.roadmapId);
const editUrl = `${SITE.repo}/edit/main/wiki/features/${d.slug}.md`;
const pdfUrl = href(`/downloads/${d.slug}.pdf`);
const mdUrl = href(`/features/${d.slug}.md`);
const sources = d.sources.filter((s) => s.kind !== 'roadmap');
// Where this briefing's governance controls live: distinct admin centres and API kinds, with how many controls each covers.
const API_KIND_LABEL: Record<string, string> = { powershell: 'PowerShell', graph: 'Microsoft Graph', 'power-platform-api': 'Power Platform API', 'pac-cli': 'Power Platform CLI', 'azure-cli': 'Azure CLI', rest: 'REST API', other: 'API' };
const surfaces = new Map<string, number>();
for (const c of d.controls) {
  if (c.ui) surfaces.set(c.ui.surface, (surfaces.get(c.ui.surface) ?? 0) + 1);
  if (c.api) surfaces.set(API_KIND_LABEL[c.api.kind] ?? 'API', (surfaces.get(API_KIND_LABEL[c.api.kind] ?? 'API') ?? 0) + 1);
}
const gaps = { ui: d.controls.filter((c) => !c.ui).length, api: d.controls.filter((c) => !c.api).length };
const roadmapSource = d.sources.find((s) => s.kind === 'roadmap');

// The independent check: a second model's claim-by-claim verdict against the roadmap record and Microsoft Learn.
const report = await verificationFor(d.slug);
const v = d.verification ?? null;
const CHECK_LABEL: Record<string, string> = {
  verified: 'Every statement confirmed against Microsoft documentation',
  'verified-with-gaps': 'Confirmed, with small corrections pending',
  'needs-correction': 'Corrections needed. Kept online with this notice while a corrected version is prepared',
  held: 'Held',
};
const ENGINE_LABEL: Record<string, string> = { copilot: 'GitHub Copilot', 'claude-code': 'Claude Code', api: 'Claude API', manual: 'a reviewer with the Microsoft Learn tools' };
const SEVERITY_LABEL: Record<string, string> = { blocker: 'Must fix', major: 'Should fix', minor: 'Minor' };
const STATUS_LABEL: Record<string, string> = { supported: 'Confirmed', unsupported: 'Not found', contradicted: 'Contradicted' };
const SEV_RANK: Record<string, number> = { blocker: 0, major: 1, minor: 2 };
const SECTION_NAMES: Record<string, string> = { whatschanging: "What's changing", whyitmatters: 'Why it matters', riskassessment: 'Risk assessment', costandlicensing: 'Cost and licensing', scope: 'Scope', governanceguidance: 'Governance guidance', governancecontrols: 'Governance controls', openquestions: 'Open questions' };
/** "controls[1].ui" -> "Governance controls, row 2, admin UI"; "front matter: defaultState" -> "Default state"; "rationale: cost" -> "Cost rationale". */
function whereLabel(where: string): string {
  return where.split(/\s*;\s*/).map((w) => {
    const ctl = w.match(/^controls\[(\d+)\](?:\.(ui|api|note))?/i);
    if (ctl) { const side = ctl[2] === 'ui' ? ', admin UI' : ctl[2] === 'api' ? ', API' : ctl[2] === 'note' ? ', note' : ''; return `Governance controls, row ${Number(ctl[1]) + 1}${side}`; }
    const fm = w.match(/^front matter:\s*(.+)$/i);
    if (fm) return fm[1].replace(/^licensing\.(model|notes)$/i, 'Licensing $1').replace(/^defaultState$/i, 'Default state').replace(/^targetDate$/i, 'Target date').replace(/^previewDate$/i, 'Preview date').replace(/^(\w)/, (m) => m.toUpperCase()).replace(/([a-z])([A-Z])/g, '$1 $2').toLowerCase().replace(/^(\w)/, (m) => m.toUpperCase());
    const rat = w.match(/^rationale:\s*(\w+)/i);
    if (rat) return `${rat[1].charAt(0).toUpperCase()}${rat[1].slice(1)} rationale`;
    const key = w.toLowerCase().replace(/[^a-z]/g, '');
    for (const [k, name] of Object.entries(SECTION_NAMES)) if (key.startsWith(k)) return w.replace(/^[^:]+/, name);
    return w.charAt(0).toUpperCase() + w.slice(1);
  }).join('; ');
}
const findings = report ? [...report.claims].filter((c) => c.status !== 'supported' || c.severity).sort((a, b) => (SEV_RANK[a.severity ?? 'minor'] ?? 3) - (SEV_RANK[b.severity ?? 'minor'] ?? 3) || a.n - b.n) : [];
const confirmedOnly = report ? report.claims.filter((c) => c.status === 'supported' && !c.severity) : [];
const needsCorrection = v?.status === 'needs-correction';
const isUrl = (s: string | null | undefined) => Boolean(s && /^https?:\/\//.test(s));
const hostOf = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, '') + new URL(u).pathname.replace(/\/$/, ''); } catch { return u; } };
---

<Base title={d.title} description={d.summary} kind="article" current="features">
  <article class="wrap">
    <header class="article-head">
      <div class="eyebrow">
        <a href={topicUrl(d.topic)}>{topic?.label ?? d.topic}</a>
        {d.roadmapId && <><span class="sep"></span><a href={roadmap!} rel="noopener">Roadmap {d.roadmapId}</a></>}
        <span class="sep"></span><Badge status={d.status} />
        <span class="sep"></span><span>Updated {formatDate(d.updated)}</span>
        {d.confidence !== 'high' && <><span class="sep"></span><span title="How well the sources support this briefing">Confidence {d.confidence}</span></>}
        <span class="sep"></span>
        {v ? (
          <a href="#verification" class={`checked checked--${v.status}`} title={`Independent check against Microsoft Learn on ${formatDate(v.date, { long: true })}: ${CHECK_LABEL[v.status] ?? v.status}.`}>{needsCorrection ? 'Awaiting correction' : `Checked ${formatDate(v.date)}`}</a>
        ) : (
          <a href="#verification" class="checked checked--none" title="This page has not yet had its independent check against Microsoft Learn.">Not yet checked</a>
        )}
      </div>
      <h1 class="display">{d.title}</h1>
      <p class="standfirst">{d.summary}</p>
      {needsCorrection && v && (
        <aside class="notice notice--correction" role="note">
          <p><b>Awaiting correction.</b> An independent check on {formatDate(v.date, { long: true })} could not confirm {v.unconfirmed} of the {v.claims} statements on this page against Microsoft documentation and found {v.contradicted} contradicted by it. They are listed under <a href="#verification">How this briefing was checked</a>. A corrected version is being prepared. Until then, confirm paths, commands and licensing against the linked Microsoft pages before acting on them.</p>
        </aside>
      )}
      <Facts data={d} rationale={rationale} />
    </header>

    <div class="article">
      <div class="article__body">
        <div class="prose">
          <Content />
        </div>

        <SectionHead title="How this briefing was checked" id="verification" />
        {report && v ? (
          <div class={`check check--${report.status}`}>
            <p class="check__summary">{report.summary}</p>
            <dl class="check__facts">
              <div><dt>Checked</dt><dd>{formatDate(report.date, { long: true })}{report.version !== d.version && <span class="muted"> (at version {report.version}; the page is now version {d.version} and is queued for a new check)</span>}</dd></div>
              <div><dt>Checked by</dt><dd>{report.model}, {ENGINE_LABEL[report.engine] ?? report.engine}, in a fresh session, against the roadmap entry and Microsoft Learn</dd></div>
              <div><dt>Statements</dt><dd><b>{report.counts.claims}</b> checked: <span class="check__n check__n--ok">{report.counts.confirmed} confirmed</span> · <span class={`check__n${report.counts.unconfirmed ? ' check__n--warn' : ''}`}>{report.counts.unconfirmed} not found in the documentation</span> · <span class={`check__n${report.counts.contradicted ? ' check__n--bad' : ''}`}>{report.counts.contradicted} contradicted</span></dd></div>
              <div><dt>Result</dt><dd>{CHECK_LABEL[report.status] ?? report.status}{report.attempts > 1 && <span class="muted"> · attempt {report.attempts}</span>}</dd></div>
            </dl>
            {findings.length > 0 && (
              <>
                <h3 class="check__h">{findings.length === 1 ? 'One finding' : `${findings.length} findings`}</h3>
                <ol class="findings">
                  {findings.map((c) => (
                    <li class={`finding finding--${c.severity ?? 'note'}`} id={`finding-${c.n}`}>
                      <div class="finding__head">
                        {c.severity && <span class={`finding__sev finding__sev--${c.severity}`}>{SEVERITY_LABEL[c.severity]}</span>}
                        <span class="finding__status">{STATUS_LABEL[c.status] ?? c.status}</span>
                        <span class="finding__where">{whereLabel(c.where)}</span>
                      </div>
                      <p class="finding__claim">{c.claim}</p>
                      {c.quote && (
                        <p class="finding__quote">{c.status === 'contradicted' ? 'Microsoft says: ' : c.status === 'unsupported' ? '' : 'Source: '}<q>{c.quote}</q>{isUrl(c.source) && <> <a href={c.source!} rel="noopener">{hostOf(c.source!)}</a></>}</p>
                      )}
                      {c.fix && <p class="finding__fix"><b>Correction.</b> {c.fix}</p>}
                    </li>
                  ))}
                </ol>
              </>
            )}
            {confirmedOnly.length > 0 && (
              <details class="claims">
                <summary>{confirmedOnly.length} statements confirmed, with the passage each rests on</summary>
                <table class="claims__table">
                  <thead><tr><th>Where</th><th>Statement</th><th>Evidence</th></tr></thead>
                  <tbody>
                    {confirmedOnly.map((c) => (
                      <tr>
                        <td data-label="Where">{whereLabel(c.where)}</td>
                        <td data-label="Statement">{c.claim}</td>
                        <td data-label="Evidence">{c.quote && <q>{c.quote}</q>}{isUrl(c.source) ? <> <a href={c.source!} rel="noopener">{hostOf(c.source!)}</a></> : c.source === 'roadmap record' ? <span class="muted"> (roadmap entry)</span> : null}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </details>
            )}
            {report.history.length > 0 && <p class="small muted check__history">Earlier checks: {report.history.map((h) => `${formatDate(h.date)} (${CHECK_LABEL[h.status]?.split('.')[0].toLowerCase() ?? h.status}, version ${h.version})`).join('; ')}.</p>}
          </div>
        ) : (
          <p class="muted check__none">Not yet checked. Every briefing is re-read by a second model, in a fresh session, against the roadmap entry and Microsoft Learn; the result appears here, statement by statement. This page is in the queue. Until then, treat its paths, commands and licensing as the writer's reading of the sources, and confirm them against the linked Microsoft pages. <a href={href('/about/#checked')}>How the check works</a>.</p>
        )}

        <SectionHead title="Microsoft guidance and references" id="references" />
        <ul class="sources">
          {roadmapSource && (
            <li><span class="kind">Roadmap</span><span><a href={roadmapSource.url} rel="noopener">{roadmapSource.title}</a><span class="url">{roadmapSource.url}</span></span></li>
          )}
          {sources.map((s) => (
            <li><span class="kind">{(SOURCE_KIND as Record<string, string>)[s.kind] ?? s.kind}</span><span><a href={s.url} rel="noopener">{s.title}</a><span class="url">{s.url}</span></span></li>
          ))}
          <li><span class="kind">Search</span><span><a href={learnSearchUrl(d.title)} rel="noopener">Search Microsoft Learn for this feature</a></span></li>
        </ul>

        <SectionHead title="Videos" id="videos" />
        {d.videos.length ? (
          <ul class="sources">
            {d.videos.map((v) => (
              <li><span class="kind">{v.channel ?? 'Video'}</span><span><a href={v.url} rel="noopener">{v.title}</a><span class="url">{v.url}</span></span></li>
            ))}
          </ul>
        ) : (
          <p class="muted">No Microsoft video has been linked for this feature yet. <a href={youtubeSearchUrl(d.title)} rel="noopener">Search YouTube</a> for Microsoft Mechanics, Microsoft 365 Community and Power CAT sessions; the daily run adds a link when one is verified.</p>
        )}

        {(related.length > 0 || inbound.length > 0) && (
          <>
            <SectionHead title="Related" id="related" />
            {atlasNode && <AtlasMini id={atlasNode.id} where={topic?.label ?? d.topic} links={atlasNode.n} />}
            <ul class="related">
              {related.map((r) => <li><a href={r.url}>{r.title}</a><span class="meta">{r.meta}</span></li>)}
              {inbound.map((f) => <li><a href={featureUrl(f.data.slug)}>{f.data.title}</a><span class="meta">Links here · {(TOPIC_BY_ID as any)[f.data.topic]?.label ?? f.data.topic}</span></li>)}
            </ul>
          </>
        )}

        <SectionHead title="Tags" id="tags" />
        <div class="chips">
          {d.tags.map((t) => <a class="chip" href={tagUrl(t)}>{tagLabel(t)}</a>)}
        </div>

        <SectionHead title="Change log" id="changes" />
        <ul class="changes" style="list-style:none;margin:0;padding:0">
          {[...d.changes].reverse().map((c) => <li><time datetime={c.date}>{formatDate(c.date)}</time><span>{c.note}</span></li>)}
          {d.roadmapModified && <li><time datetime={d.roadmapModified}>{formatDate(d.roadmapModified)}</time><span class="muted">Roadmap entry last modified by Microsoft</span></li>}
        </ul>
        <p class="small muted" style="margin-top:1.2rem">
          Version {d.version} · created {formatDate(d.created)} · confidence {d.confidence}. This briefing was written from the sources above{v && v.status !== 'needs-correction' ? `, checked independently against Microsoft Learn on ${formatDate(v.date)},` : ''} and is reviewed when the roadmap entry changes.
          Spotted an error? <a href={editUrl} rel="noopener">Propose a change on GitHub</a>.
        </p>
      </div>

      <aside class="article__aside no-print">
        <nav class="panel toc" aria-label="On this page">
          <h3>On this page</h3>
          <ol>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            <li><a href="#verification">How this briefing was checked</a></li>
            <li><a href="#references">Microsoft guidance and references</a></li>
            <li><a href="#related">Related</a></li>
          </ol>
        </nav>
        <div class="panel">
          <h3>Download</h3>
          <div class="downloads">
            <a href={pdfUrl} download><span>Briefing as PDF</span><span class="ext">A4 · PDF</span></a>
            <a href={mdUrl} download={`${d.slug}.md`}><span>Briefing as Markdown</span><span class="ext">Obsidian · MD</span></a>
            {roadmap && <a href={roadmap} rel="noopener"><span>Microsoft 365 Roadmap entry</span><span class="ext">↗</span></a>}
            <button class="btn-ghost" type="button" onclick="window.print()" style="justify-content:space-between"><span>Print this page</span><span class="ext mono">⌘P</span></button>
          </div>
        </div>
        {d.controls.length > 0 && (
          <div class="panel">
            <h3>Control surfaces</h3>
            <ul class="surfaces">
              {[...surfaces.entries()].sort((x, y) => y[1] - x[1] || x[0].localeCompare(y[0])).map(([name, n]) => <li><a href="#governance-controls">{name}</a><span class="n">{n} {n === 1 ? 'control' : 'controls'}</span></li>)}
              {gaps.ui > 0 && <li><span class="gap">No admin UI documented</span><span class="n">{gaps.ui} of {d.controls.length}</span></li>}
              {gaps.api > 0 && <li><span class="gap">No API documented</span><span class="n">{gaps.api} of {d.controls.length}</span></li>}
            </ul>
            <p class="surfaces__foot">Paths and cmdlets as Microsoft Learn documents them. Gaps are stated, not guessed.</p>
          </div>
        )}
        <div class="panel">
          <h3>Products</h3>
          <div class="chips">{d.products.map((p) => <span class="chip">{p}</span>)}</div>
        </div>
      </aside>
    </div>
  </article>
</Base>
