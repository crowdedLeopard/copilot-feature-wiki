---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import SectionHead from '../../components/SectionHead.astro';
import NoticeRow from '../../components/NoticeRow.astro';
import { allNotices, allFeaturesIncludingArchived, catalog } from '../../lib/data';
import { TOPIC_BY_ID, MESSAGE_CENTER, href, topicUrl, featureUrl, roadmapUrl, formatDate, daysUntil, relativeDays } from '../../lib/site';

export async function getStaticPaths() {
  const notices = await allNotices();
  return notices.map((n) => ({ params: { id: n.data.id }, props: { entry: n } }));
}

const { entry } = Astro.props;
const d = entry.data;
const topic = (TOPIC_BY_ID as Record<string, { label: string }>)[d.topic];
const features = await allFeaturesIncludingArchived();
const briefings = d.roadmapIds.map((id) => features.find((f) => f.data.roadmapId === id)).filter(Boolean) as typeof features;
const tracked = d.roadmapIds.map((id) => ({ id, item: catalog.items.find((i) => i.id === id), briefing: briefings.find((f) => f.data.roadmapId === id) }));
const days = daysUntil(d.actionRequiredBy);
const notices = await allNotices();
// Other posts about the same roadmap items, or failing that the same services, most recent first.
const related = notices.filter((n) => n.data.id !== d.id && (n.data.roadmapIds.some((id) => d.roadmapIds.includes(id)) || (d.roadmapIds.length === 0 && n.data.services.some((s) => d.services.includes(s))))).slice(0, 6);
const sev = (MESSAGE_CENTER.severity as Record<string, { label: string }>)[d.severity]?.label ?? d.severity;
const tagHelp = MESSAGE_CENTER.tagHelp as Record<string, string>;
const revised = d.lastModified.slice(0, 10) !== d.published.slice(0, 10);
const description = d.summary || `Microsoft 365 Message Center post ${d.id}, published ${formatDate(d.published)}.`;
---

<Base title={`${d.id}: ${d.title}`} description={description} kind="article" current="message-centre">
  <article class="wrap">
    <header class="article-head">
      <div class="eyebrow">
        <a href={href('/message-centre/')}>Message Centre</a>
        <span class="sep"></span><span>{d.id}</span>
        <span class="sep"></span><a href={topicUrl(d.topic)}>{topic?.label ?? d.topic}</a>
        <span class="sep"></span><Badge category={d.category} />
        {d.isMajorChange && <><span class="sep"></span><span>Major change</span></>}
        <span class="sep"></span><span>{revised ? `Revised ${formatDate(d.lastModified)}` : `Published ${formatDate(d.published)}`}</span>
      </div>
      <h1 class="display">{d.title}</h1>
      {d.summary && <p class="standfirst">{d.summary}</p>}
      <div class="facts" role="table" aria-label="At a glance">
        {d.actionRequiredBy && (
          <div class="fact fact--act"><div class="fact__k">Act by</div><div class="fact__v">{formatDate(d.actionRequiredBy)}<small>{relativeDays(days)}</small></div></div>
        )}
        <div class="fact"><div class="fact__k">Category</div><div class="fact__v"><Badge category={d.category} /></div></div>
        <div class="fact"><div class="fact__k">Severity</div><div class="fact__v">{sev}</div></div>
        <div class="fact"><div class="fact__k">Major change</div><div class="fact__v">{d.isMajorChange ? 'Yes' : 'No'}</div></div>
        <div class="fact"><div class="fact__k">Published</div><div class="fact__v">{formatDate(d.published)}</div></div>
        <div class="fact"><div class="fact__k">Last revised</div><div class="fact__v">{formatDate(d.lastModified)}</div></div>
        {d.endDate && <div class="fact"><div class="fact__k">Microsoft's end date</div><div class="fact__v">{formatDate(d.endDate)}</div></div>}
        <div class="fact"><div class="fact__k">Services</div><div class="fact__v">{d.services.length ? d.services.join(', ') : 'Not stated'}</div></div>
        {d.tags.length > 0 && <div class="fact"><div class="fact__k">Microsoft's tags</div><div class="fact__v">{d.tags.map((t, i) => <><span title={tagHelp[t]}>{t}</span>{i < d.tags.length - 1 ? ', ' : ''}</>)}</div></div>}
        <div class="fact fact--wide"><div class="fact__k">Roadmap items</div><div class="fact__v">
          {tracked.length === 0 && <span class="muted">The post names no roadmap item.</span>}
          {tracked.map((t, i) => (
            <>{i > 0 && <span class="muted"> · </span>}<a href={roadmapUrl(t.id)!} rel="noopener">{t.id}</a>{t.item && <span class="muted"> {t.item.title}</span>}{t.briefing ? <> (<a href={featureUrl(t.briefing.data.slug)}>briefing</a>)</> : t.item ? <span class="muted"> (not yet briefed)</span> : null}</>
          ))}
        </div></div>
      </div>
    </header>

    <div class="article">
      <div class="article__body">
        <SectionHead title="What Microsoft said" id="text" />
        <p class="mc-text__note">Text as Microsoft published it to tenant administrators, last revised {formatDate(d.lastModified, { long: true })}. Your own Message Center may carry a later revision or details specific to your tenant.</p>
        <div class="mc-text">
          <div class="prose" set:html={d.bodyHtml || `<p>${d.body}</p>`} />
        </div>

        {briefings.length > 0 && (
          <>
            <SectionHead title="Briefings for this change" id="briefings" />
            <ul class="related">
              {briefings.map((f) => <li><a href={featureUrl(f.data.slug)}>{f.data.title}</a><span class="meta">{f.data.summary}</span></li>)}
            </ul>
          </>
        )}

        <SectionHead title="Microsoft links" id="links" />
        <ul class="sources">
          <li><span class="kind">Message Centre</span><span><a href={d.url} rel="noopener">{d.id} in the Microsoft 365 admin center</a><span class="url">Opens in your own tenant; needs a Message Center role.</span></span></li>
          {d.links.external && <li><span class="kind">More information</span><span><a href={d.links.external} rel="noopener">{d.links.external.replace(/^https?:\/\//, '').split('?')[0]}</a></span></li>}
          {d.links.blog && <li><span class="kind">Blog</span><span><a href={d.links.blog} rel="noopener">{d.links.blog.replace(/^https?:\/\//, '').split('?')[0]}</a></span></li>}
          {d.links.help && <li><span class="kind">Help</span><span><a href={d.links.help} rel="noopener">{d.links.help.replace(/^https?:\/\//, '').split('?')[0]}</a></span></li>}
          {d.roadmapIds.map((id) => <li><span class="kind">Roadmap</span><span><a href={roadmapUrl(id)!} rel="noopener">Microsoft 365 Roadmap {id}</a></span></li>)}
        </ul>

        {related.length > 0 && (
          <>
            <SectionHead title="Related posts" id="related" />
            <ul class="notices">{related.map((n) => <NoticeRow entry={n} compact />)}</ul>
          </>
        )}
      </div>

      <aside class="article__aside no-print">
        <div class="panel">
          <h3>In your tenant</h3>
          <div class="downloads">
            <a href={d.url} rel="noopener"><span>Open {d.id} in Message Center</span><span class="ext">↗</span></a>
          </div>
          <p class="surfaces__foot">The post as Microsoft shows it to your organisation, with any tenant-specific details and the latest revision.</p>
        </div>
        {briefings.length > 0 && (
          <div class="panel">
            <h3>Briefings</h3>
            <ul class="surfaces">{briefings.map((f) => <li><a href={featureUrl(f.data.slug)}>{f.data.title}</a></li>)}</ul>
          </div>
        )}
        <div class="panel">
          <h3>Services</h3>
          <div class="chips">{d.services.map((s) => <span class="chip">{s}</span>)}{d.services.length === 0 && <span class="muted small">Not stated</span>}</div>
        </div>
      </aside>
    </div>
  </article>
</Base>
