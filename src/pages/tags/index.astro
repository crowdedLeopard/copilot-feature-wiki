---
import Base from '../../layouts/Base.astro';
import { allFeatures, allConcepts, tagCounts } from '../../lib/data';
import { tagUrl, tagLabel } from '../../lib/site';

const features = await allFeatures();
const concepts = await allConcepts();
const tags = tagCounts(features, concepts);
---

<Base title="Tags" description="Every tag used across briefings and concepts.">
  <div class="wrap wrap--narrow">
    <div class="article-head" style="padding-bottom:1rem">
      <div class="eyebrow"><span>Tags</span><span class="sep"></span><span>{tags.length} tags</span></div>
      <h1 class="display">Tags</h1>
      <p class="standfirst">Tags cross the desks. Sized by how often they appear.</p>
    </div>
    <div class="chips" style="margin-top:1.5rem;gap:0.6rem">
      {tags.map(([t, n]) => <a class="chip" href={tagUrl(t)} style={`font-size:${Math.min(1.25, 0.8 + n * 0.08)}rem`}>{tagLabel(t)} <span class="muted mono" style="font-size:0.7em">{n}</span></a>)}
    </div>
  </div>
</Base>
