---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { allFeatures, allConcepts, tagCounts } from '../../lib/data';
import { SITE, tagUrl } from '../../lib/site';
import { groupTags } from '../../lib/tags';

const features = await allFeatures();
const concepts = await allConcepts();
const counts = tagCounts(features, concepts);
const groups = groupTags(counts);
const undefinedCount = groups.reduce((n, g) => n + g.tags.filter((t) => !t.defined).length, 0);
---

<Base title="Tags" description="Every tag used across the briefings and concepts, with what each one means.">
  <div class="wrap">
    <div class="article-head" style="padding-bottom:1rem">
      <div class="eyebrow"><span>Tags</span><span class="sep"></span><span>{counts.length} tags</span><span class="sep"></span><span>{groups.length} groups</span></div>
      <h1 class="display">Tag glossary</h1>
      <p class="standfirst">Tags cut across the topics and join pages that share a product, a control, a meter or a risk. Each tag has a plain-English name and a one-line explanation; the daily run defines a new tag the first time it uses it.</p>
      <nav class="chips" style="margin-top:1.2rem" aria-label="Tag groups">
        {groups.map((g) => <a class="chip" href={`#${g.id}`} title={g.blurb}>{g.label}<span class="n">{g.tags.length}</span></a>)}
      </nav>
    </div>

    {groups.map((g) => (
      <section>
        <SectionHead title={`${g.label} · ${g.tags.length}`} id={g.id} />
        <p class="muted" style="margin:-0.3rem 0 0.6rem;max-width:70ch">{g.blurb}</p>
        <dl class="glossary">
          {g.tags.map((t) => (
            <div class="glossary__row">
              <dt><a href={tagUrl(t.tag)}>{t.label}</a><span class="n">{t.count}</span><span class="id">{t.tag}</span></dt>
              <dd>{t.description || <em>No description yet.</em>}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))}

    <p class="small muted" style="margin-top:2rem;max-width:70ch">
      The glossary is a file in the repository, <a href={`${SITE.repo}/blob/main/wiki/tags.json`} rel="noopener">wiki/tags.json</a>. The daily run adds an entry for each new tag and never overwrites one that already has a description, so a correction made there stays.
      {undefinedCount > 0 && ` ${undefinedCount} ${undefinedCount === 1 ? 'tag is' : 'tags are'} still waiting for a description.`}
    </p>
  </div>
</Base>
