---
import Base from '../layouts/Base.astro';
import { href } from '../lib/site';
---

<Base title="Page not found" noindex>
  <div class="wrap wrap--narrow" style="padding:4rem 0">
    <div class="eyebrow"><span>404</span></div>
    <h1 class="display">That page is not in the ledger.</h1>
    <p class="standfirst">Briefings are renamed when Microsoft renames a feature, so the link may have moved. Try the search (<kbd>⌘</kbd><kbd>K</kbd>) or start from the <a href={href('/features/')}>list of briefings</a>.</p>
  </div>
</Base>
