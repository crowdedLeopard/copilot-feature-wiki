---
import Base from '../../layouts/Base.astro';
import FeatureRow from '../../components/FeatureRow.astro';
import SectionHead from '../../components/SectionHead.astro';
import { allFeatures, byTopic, catalog } from '../../lib/data';
import { TOPICS, href, topicUrl } from '../../lib/site';

const features = await allFeatures();
const topics = byTopic(features);
const tracked = new Map<string, number>();
for (const i of catalog.items) if (i.topic) tracked.set(i.topic, (tracked.get(i.topic) ?? 0) + 1);
---

<Base title="Topics" description="Briefings grouped by topic: Copilot Studio and agents, Power Platform, governance and security, Microsoft 365 Copilot and Modern Work." current="topics">
  <div class="wrap">
    <div class="article-head" style="padding-bottom:1rem">
      <div class="eyebrow"><span>Topics</span><span class="sep"></span><span>{TOPICS.length} topics</span></div>
      <h1 class="display">Topics</h1>
      <p class="standfirst">Every roadmap item is filed under one topic, according to the products Microsoft tags it with. An item that touches several products goes to the most specific one.</p>
    </div>
    {TOPICS.map((d) => {
      const list = topics.get(d.id) ?? [];
      return (
        <section>
          <SectionHead title={`${d.label} · ${list.length} briefed · ${(tracked.get(d.id) ?? 0).toLocaleString('en-GB')} tracked`} more={{ href: topicUrl(d.id), label: 'Open topic' }} />
          <p class="muted" style="margin:-0.3rem 0 0.5rem">{d.blurb}</p>
          <ul class="ledger">
            {list.slice(0, 3).map((f) => <FeatureRow entry={f} compact showTopic={false} />)}
            {list.length === 0 && <li class="row row--compact"><div></div><p class="muted" style="margin:0">No briefings yet. The <a href={href(`/radar/${d.id}/`)}>radar</a> lists what is tracked.</p></li>}
          </ul>
        </section>
      );
    })}
  </div>
</Base>
