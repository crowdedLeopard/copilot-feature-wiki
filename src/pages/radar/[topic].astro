---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Badge from '../../components/Badge.astro';
import { allFeatures, briefedIds, catalog } from '../../lib/data';
import { TOPICS, href, featureUrl, formatDate, shortRoadmapDate } from '../../lib/site';

export function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { topic: t.id }, props: { topic: t } }));
}
const { topic } = Astro.props;
const features = await allFeatures();
const briefed = briefedIds(features);
const items = catalog.items.filter((i) => i.topic === topic.id).sort((a, b) => b.modified.localeCompare(a.modified));
const groups: [string, typeof items][] = [
  ['Rolling out', items.filter((i) => i.statusKey === 'rolling-out')],
  ['In development', items.filter((i) => i.statusKey === 'in-development')],
  ['Launched', items.filter((i) => i.statusKey === 'launched')],
  ['Cancelled', items.filter((i) => i.statusKey === 'cancelled')],
];
---

<Base title={`Radar: ${topic.label}`} description={`All ${items.length} tracked roadmap items for ${topic.label}.`} current="radar">
  <div class="wrap">
    <div class="article-head" style="padding-bottom:1rem">
      <div class="eyebrow"><a href={href('/radar/')}>Radar</a><span class="sep"></span><a href={href(`/topics/${topic.id}/`)}>{topic.label}</a><span class="sep"></span><span>{items.length.toLocaleString('en-GB')} items</span></div>
      <h1 class="display">{topic.label} radar</h1>
      <p class="standfirst">Every tracked roadmap item for this topic, newest change first. Items with a briefing link to it; the rest are waiting their turn in the twice-daily run, which shares its briefings equally across the five topics.</p>
      <input class="search-box" id="radar-filter" type="search" placeholder="Filter this table" aria-label="Filter the table" style="margin-top:1.2rem;max-width:420px" />
    </div>
    {groups.filter(([, list]) => list.length).map(([label, list]) => (
      <section>
        <SectionHead title={`${label} · ${list.length.toLocaleString('en-GB')}`} />
        <table class="radar radar--filterable">
          <thead><tr><th>Roadmap item</th><th>ID</th><th>Target</th><th>Modified</th><th>Briefing</th></tr></thead>
          <tbody>
            {list.map((i) => {
              const b = briefed.get(i.id);
              return (
                <tr data-text={`${i.title} ${i.products.join(' ')} ${i.id}`.toLowerCase()}>
                  <td class="t"><a href={i.roadmapUrl} rel="noopener">{i.title}</a><br /><span class="muted small">{i.products.slice(0, 3).join(', ')}</span></td>
                  <td class="id">{i.id}</td>
                  <td class="d">{shortRoadmapDate(i.targetDate)}</td>
                  <td class="d">{formatDate(i.modified)}</td>
                  <td>{b ? <a class="briefed" href={featureUrl(b.data.slug)}>Read briefing</a> : <span class="muted small" title="Tracked. Waiting its turn in the twice-daily run.">Not yet briefed</span>}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>
    ))}
  </div>
</Base>

<script>
  const input = document.getElementById('radar-filter') as HTMLInputElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.radar--filterable tbody tr'));
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    for (const r of rows) r.hidden = q ? !(r.dataset.text ?? '').includes(q) : false;
  });
</script>
