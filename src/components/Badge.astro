---
import { ACTION, STATUS } from '../lib/site';

/**
 * A small uppercase label for an action ("Act now", "Prepare", "Review", "No action") or a roadmap
 * status ("In development", "Rolling out", ...). The taxonomy's help text is the tooltip, and the
 * Legend component spells the same text out for readers who do not hover.
 */
interface Props {
  action?: string;
  status?: string;
  text?: string;
  title?: string;
}
const { action, status, text, title } = Astro.props;
let cls = 'badge';
let label = text ?? '';
let help = title ?? '';
if (action) {
  const a = (ACTION as Record<string, { label: string; help: string }>)[action];
  cls += ` badge--${action}`;
  label = a?.label ?? action;
  help = a ? `Action: ${a.label}. ${a.help}` : '';
} else if (status) {
  const s = (STATUS as Record<string, { label: string; help: string }>)[status];
  cls += ` badge--status-${status}`;
  label = s?.label ?? status;
  help = s ? `Status: ${s.label}. ${s.help}` : '';
}
---

<span class={cls} title={help || undefined}>{label}</span>
