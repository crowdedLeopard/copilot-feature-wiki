---
import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';
import Rating from './Rating.astro';
import { TOPIC_BY_ID, featureUrl, topicUrl, formatDate, shortRoadmapDate } from '../lib/site';

interface Props {
  entry: CollectionEntry<'features'>;
  compact?: boolean;
  showTopic?: boolean;
  /** Add data-* attributes for client-side filtering */
  filterable?: boolean;
}
const { entry, compact = false, showTopic = true, filterable = false } = Astro.props;
const d = entry.data;
const topic = (TOPIC_BY_ID as Record<string, { label: string; short: string }>)[d.topic];
const attrs = filterable
  ? {
      'data-topic': d.topic,
      'data-risk': d.risk,
      'data-cost': d.cost,
      'data-impact': d.impact,
      'data-action': d.action,
      'data-status': d.status,
      'data-default': d.defaultState,
      'data-licensing': d.licensing.model,
      'data-audiences': d.audiences.join(' '),
      'data-tags': d.tags.join(' '),
      'data-updated': d.updated,
      'data-title': d.title.toLowerCase(),
      'data-text': `${d.title} ${d.summary} ${d.products.join(' ')} ${d.tags.join(' ')} ${d.roadmapId ?? ''}`.toLowerCase(),
    }
  : {};
---

<li class={`row${compact ? ' row--compact' : ''}`} {...attrs}>
  <div class="row__action"><Badge action={d.action} /></div>
  <div>
    <h3 class="row__title"><a href={featureUrl(d.slug)}>{d.title}</a></h3>
    <p class="row__summary">{d.summary}</p>
    <div class="row__meta">
      {showTopic && <a href={topicUrl(d.topic)} class="muted" style="text-decoration:none">{topic?.label ?? d.topic}</a>}
      <Badge status={d.status} />
      <Rating kind="risk" value={d.risk} />
      <Rating kind="cost" value={d.cost} />
      {!compact && <Rating kind="impact" value={d.impact} />}
      <span class="mono">{d.status === 'launched' ? 'Launched' : `Target ${shortRoadmapDate(d.targetDate)}`}</span>
      <span class="mono">Updated {formatDate(d.updated)}</span>
      {d.verification?.status === 'needs-correction'
        ? <span class="mono row__flag" title="An independent check against Microsoft Learn could not confirm part of this page. It stays online with a notice while a corrected version is prepared.">Awaiting correction</span>
        : d.verification
          ? <span class="mono row__check" title={`Checked independently against Microsoft Learn on ${formatDate(d.verification.date, { long: true })}: ${d.verification.confirmed} of ${d.verification.claims} statements confirmed.`}>Checked {formatDate(d.verification.date)}</span>
          : <span class="mono row__unchecked" title="This page has not yet had its independent check against Microsoft Learn.">Not yet checked</span>}
    </div>
  </div>
</li>
