---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { SITE, href } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Page type for the <title> suffix and og:type */
  kind?: 'home' | 'page' | 'article';
  bodyClass?: string;
  current?: 'features' | 'desks' | 'radar' | 'concepts' | 'atlas' | 'digests' | 'about';
  noindex?: boolean;
}

const { title, description = SITE.tagline, kind = 'page', bodyClass = '', current, noindex = false } = Astro.props;
const fullTitle = kind === 'home' ? `${SITE.name} · Microsoft Copilot, Power Platform and Modern Work changes` : `${title} · ${SITE.name}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname;
const nav = [
  { id: 'features', label: 'Briefings', to: '/features/' },
  { id: 'desks', label: 'Desks', to: '/desks/' },
  { id: 'radar', label: 'Radar', to: '/radar/' },
  { id: 'concepts', label: 'Concepts', to: '/concepts/' },
  { id: 'atlas', label: 'Atlas', to: '/atlas/' },
  { id: 'digests', label: 'Weekly', to: '/digests/' },
  { id: 'about', label: 'About', to: '/about/' },
] as const;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} briefings`} href={href('/rss.xml')} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={kind === 'article' ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f6f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131416" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('rl-theme');
          if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead" id="masthead">
      <div class="wrap masthead__row">
        <a class="brand" href={href('/')} aria-label={`${SITE.name} home`}>
          <span class="brand__name">{SITE.name}</span>
          <span class="brand__tag">Copilot · Power Platform · Modern Work</span>
        </a>
        <nav class="nav" aria-label="Primary">
          {nav.map((n) => (
            <a href={href(n.to)} aria-current={current === n.id ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="nav__tools">
          <button class="btn-ghost" type="button" id="search-open" aria-label="Search the ledger">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <span>Search</span>
            <kbd>⌘K</kbd>
          </button>
          <button class="btn-ghost" type="button" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
            <svg class="icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
          </button>
          <button class="btn-ghost menu-toggle" type="button" id="menu-toggle" aria-label="Menu" aria-expanded="false">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer__row">
        <div>
          <p><strong>{SITE.name}</strong>. {SITE.tagline}</p>
          <p>Built from the Microsoft 365 Roadmap and Microsoft Learn, refreshed daily. Assessments are editorial judgements, not Microsoft statements; verify against the linked sources before acting.</p>
        </div>
        <div>
          <p><a href={SITE.repo} rel="noopener">Source on GitHub</a> · <a href={href('/rss.xml')}>RSS</a> · <a href={href('/about/')}>How this works</a></p>
          <p class="mono small">Not affiliated with Microsoft. Product names are trademarks of their owners.</p>
        </div>
      </div>
    </footer>

    <dialog class="search" id="search" aria-label="Search">
      <form method="dialog" style="margin:0">
        <input class="search__input" id="search-input" type="search" placeholder="Search briefings, concepts, tags…" autocomplete="off" spellcheck="false" aria-controls="search-results" />
        <ul class="search__results" id="search-results" role="listbox"></ul>
        <div class="search__hint"><span><kbd>↑</kbd> <kbd>↓</kbd> to move</span><span><kbd>↵</kbd> to open</span><span><kbd>esc</kbd> to close</span></div>
      </form>
    </dialog>

    <script>
      import { initShell } from '../scripts/shell';
      initShell();
    </script>
  </body>
</html>

<style is:global>
  :root[data-theme='dark'] .icon-sun, :root:not([data-theme]) .icon-sun { display: none; }
  :root[data-theme='dark'] .icon-moon, :root:not([data-theme]) .icon-moon { display: block; }
  :root[data-theme='light'] .icon-moon { display: none; }
  :root[data-theme='light'] .icon-sun { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .icon-sun { display: block; }
    :root:not([data-theme]) .icon-moon { display: none; }
  }
</style>
